<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Force canonical host + HTTPS (prevents www/http duplicate content for SEO)
    #
    # The host is captured WITHOUT any :port. Building the target from %{HTTP_HOST}
    # directly would carry an explicit port across, e.g.
    # http://site:80/about -> https://site:80/about, which redirects to itself.
    #
    # Skipped for local dev hosts (localhost / 127.0.0.1) on any port. The exclusion is
    # non-capturing so it cannot overwrite the %1 captured by the condition above it.
    RewriteCond %{HTTP_HOST} ^([^:]+)(?::[0-9]+)?$ [NC]
    RewriteCond %{HTTP_HOST} !^(?:localhost|127\.0\.0\.1)(?::[0-9]+)?$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # Strip a leading www., again without carrying any port into the target.
    RewriteCond %{HTTP_HOST} ^www\.(.+?)(?::[0-9]+)?$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
